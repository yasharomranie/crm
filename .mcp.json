{
    "mcpServers": {
        "laravel-boost": {
            "command": "php",
            "args": [
                "artisan",
                "boost:mcp"
            ]
        },
        "graphify": {
            "command": "graphify-mcp",
            "args": [
                "graphify-out/graph.json"
            ]
        }
    }
}
